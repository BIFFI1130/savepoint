**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# SavePoint: 環境変数・シークレット（Supabase URL/anonキー等）はコミットしない
/env/*.json
!/env/dev.example.json
!/env/prod.example.json

# Supabase CLI
/supabase/.branches
/supabase/.temp

# SavePoint: Android本番署名用キーストア・パスワード（絶対にコミットしない）
/android/app/upload-keystore.jks
/android/key.properties

# SavePoint: adb/uiautomatorでのUI検証時に生成される一時ファイル
/window_dump.xml
/window_screenshot.png
/screenshots/

# SavePoint: Node製ツール（tools/配下）の依存パッケージ
/tools/**/node_modules/

# SavePoint: ローカル控え用のsecretsメモ（値自体はmigrationにも埋め込まれているが、
# 参照用にここにも控えている。バラ撒きを避けるためgit管理はしない）
/supabase/SECRETS.local.md
