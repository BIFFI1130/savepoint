<?xml version="1.0" encoding="utf-8"?>
<!--
    ホームのゲームカバー横スクロール一覧に紛れ込ませるネイティブ広告カード。
    ゲームカード（カバー画像がフル表示・下部にタイトルを重ねる）と近い見た目にしている。
-->
<com.google.android.gms.ads.nativead.NativeAdView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- FrameLayoutでは兄弟View同士の相対位置指定ができず、headline/CTAの右端が
         広告主アイコンと重なる実装不備（AdMob native ad validator「Assets can not be
         placed on top of another asset」で検出）が起きていたため、RelativeLayoutに
         変更し、headline/CTAの右端をアイコンの左端、headlineの下端をCTAの上端に
         明示的に固定する（テキストの長さに関わらず重ならないようにするため）。 -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- メディア素材の読み込みに失敗した場合や、画像を持たない広告クリエイティブの
             場合に背景が真っ黒になり「表示が壊れている」ように見えてしまうため、
             中間グレーでフォールバックする（CoverImageのプレースホルダーと近いトーン）。 -->
        <com.google.android.gms.ads.nativead.MediaView
            android:id="@+id/ad_media"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#616161" />

        <View
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_alignParentBottom="true"
            android:background="#B3000000" />

        <!-- 広告主アイコン。素材が提供されているのにViewが未設定だと実装不備として
             検証ツールに指摘されるため、右下に小さく表示する。headline/CTAの右端の
             基準にするため、先に配置する。 -->
        <ImageView
            android:id="@+id/ad_icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_alignParentBottom="true"
            android:layout_alignParentEnd="true"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="7dp"
            android:background="@android:color/transparent"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/ad_call_to_action"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_alignParentStart="true"
            android:layout_toStartOf="@id/ad_icon"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="4dp"
            android:layout_marginBottom="6dp"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:background="#FFFFFF"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="#000000"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/ad_headline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_above="@id/ad_call_to_action"
            android:layout_alignParentStart="true"
            android:layout_toStartOf="@id/ad_icon"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="4dp"
            android:layout_marginBottom="4dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_alignParentStart="true"
            android:layout_margin="4dp"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:background="#99000000"
            android:text="広告"
            android:textColor="#FFFFFF"
            android:textSize="10sp" />

        <!-- AdMobのポリシーで表示が必須の「広告に関する選択肢」アイコン。
             左上の「広告」バッジと重ならないよう右上に配置する。 -->
        <com.google.android.gms.ads.nativead.AdChoicesView
            android:id="@+id/ad_choices"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_alignParentEnd="true"
            android:layout_margin="4dp" />

    </RelativeLayout>
</com.google.android.gms.ads.nativead.NativeAdView>
