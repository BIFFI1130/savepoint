<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- 積みゲーリマインダー（ローカル通知）用。Android 13+では実行時許可が必要。 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- 端末再起動後もスケジュール済みのローカル通知を維持するために必要。 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <application
        android:label="savepoint"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false">
        <!-- allowBackup未指定時の既定値（true）だと、Android標準の自動クラウド
             バックアップ経由でSharedPreferences（Supabaseのセッション情報を含む）が
             ユーザーのGoogleアカウントへ同期されてしまう。root化やADBアクセス不要で、
             Googleアカウント側が侵害されただけでセッションを読み取られうるため無効化する。 -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- パスワード再設定メールのリンク（savepoint://reset-password）と
                 プロフィール共有リンク（savepoint://user/{userId}）を受け取るための
                 カスタムURLスキーム。 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="savepoint" android:host="reset-password"/>
                <data android:scheme="savepoint" android:host="user"/>
            </intent-filter>
        </activity>
        <!-- 積みゲーの中で発売が一番近い作品を表示するホーム画面ウィジェット。 -->
        <receiver
            android:name=".BacklogWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/backlog_widget_info"/>
        </receiver>
        <!-- 積みゲーの中で本日発売の作品を画像付きで一覧表示するホーム画面ウィジェット。 -->
        <receiver
            android:name=".TodayReleasesWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/today_releases_widget_info"/>
        </receiver>
        <!-- 週間記録ストリークの週数を表示するホーム画面ウィジェット。 -->
        <receiver
            android:name=".StreakWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/streak_widget_info"/>
        </receiver>
        <!-- 今月の記録本数を表示するホーム画面ウィジェット。 -->
        <receiver
            android:name=".MonthlyStatsWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/monthly_stats_widget_info"/>
        </receiver>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        <!-- AdMob（アプリ内バナー広告）。本番App ID（AdMobで「SavePoint (Android)」として
             2026-08-29に発行）。広告ユニットID自体はCodemagicの環境変数
             （ADMOB_BANNER_AD_UNIT_ID等、lib/core/config/env.dart参照）で切り替える方式
             のため、テスト広告のまま運用したい間は環境変数側を未設定にしておけばよい。 -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-7923845788845154~3419395439" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- url_launcherでIGDBの帰属リンクをブラウザで開くために必要（Android 11+のパッケージ可視性制限） -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <category android:name="android.intent.category.BROWSABLE"/>
            <data android:scheme="https"/>
        </intent>
    </queries>
</manifest>
